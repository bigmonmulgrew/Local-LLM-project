# Copy this file to .env before starting the stack.

# Shared  settings
ENVIRONMENT_TYPE=dev                                     # Environment type, valid options "dev", "local", "test", "prod"
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=local-llm-project
OLLAMA_MODEL=gemma3:4b                      # Default models, later additions may allow user to specify
OLLAMA_MODEL_STORAGE="./.ollama_data"      # Local AI model storage Default is inside repo
GENERATE_FREEZE=false                       # Generate freeze file for API container - WARNING, this allows overwriting the freeze file in the repo

# Internal service and published ports. MySQL and Ollama default to loopback-only access.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000
AI_PORT=8020
DB_HOST=mysql
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434

# Database connection settings.
MYSQL_DATABASE=3lmproject
MYSQL_USER=3lmproject
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# File handling for persistent chat attachments.
UPLOAD_DIRECTORY=/app/data/uploads
MAX_UPLOAD_FILES=5
MAX_UPLOAD_FILE_BYTES=10485760
MAX_UPLOAD_TOTAL_BYTES=26214400
