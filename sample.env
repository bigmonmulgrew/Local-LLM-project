# Copy this file to .env before starting the stack.
COMPOSE_PROJECT_NAME=local-llm-project

# Published ports. MySQL and Ollama default to loopback-only access.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8000
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_PORT=11434

# Change these values before using the stack outside local development.
MYSQL_DATABASE=3lmproject
MYSQL_USER=3lmproject
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Shared application settings.
LOG_LEVEL=INFO
OLLAMA_MODEL=gemma3:1b
